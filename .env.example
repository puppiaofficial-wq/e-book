# Copy to .env (or export these) before running `npm start`.

# HTTP port
PORT=8080

# Absolute, public base URL of this installation.
# Used to build share links, embed snippets and QR codes.
PUBLIC_BASE_URL=https://catalog.example.com

# Where books, images and analytics are stored (defaults to ./data)
EBOOK_DATA_DIR=./data

# Optional: fixed session secret. If omitted, one is generated into data/.secret
SESSION_SECRET=

# Optional: bootstrap the admin account on first launch
ADMIN_EMAIL=
ADMIN_PASSWORD=
